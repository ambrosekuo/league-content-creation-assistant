# Copy to .env in this folder, then fill in real values:
#   cp .env.example .env
#
# Never commit .env

# --- Riot (League match timelines) ---
RIOT_API_KEY=RGAPI-your-key-here
RIOT_ID=lolAmbrosek#twtv
RIOT_REGION=americas

# --- Freesound (local CC0 sting pack via fetch_stings.py) ---
# Create a key at https://freesound.org/apiv2/apply
# FREESOUND_API_KEY=your-freesound-api-key

# --- GIFs (fetch_gifs.py uses Wikimedia Commons, no key) ---

# --- Clip classification (review UI → AI Classify) ---
# OPENAI_API_KEY=sk-your-key-here
# CLIP_AI_PROVIDER=openai
# OPENAI_MODEL=gpt-5-nano
#
# Caption ASR (text burned onto portraits). Default is gpt-4o-mini-transcribe.
# Event-window snap (transcribe_event_windows.py) stays local whisper unless you pass --asr openai.
# CAPTION_ASR=openai
# CAPTION_ASR_MODEL=gpt-4o-mini-transcribe
# TRANSCRIBE_ASR=whisper
#
# --- Portrait captions (caption_portraits.py --to es) ---
# Same OPENAI_API_KEY. Optional dedicated translate model:
# CAPTION_TRANSLATE_MODEL=gpt-4o-mini

# --- Twitch (list channel VODs) ---
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_CHANNEL=lolambrosek

# --- Posting shorts (post_short.py / review UI Post tab) ---
# Tokens are cached in .secrets/ (gitignored). Authorize once:
#   pip install -r requirements-post.txt
#   python post_short.py --login youtube
#   python post_short.py --login tiktok
#
# YouTube: Google Cloud console → APIs & Services → Credentials →
# OAuth client ID → Desktop app. Enable "YouTube Data API v3" on the project.
# Drop the downloaded client_secret*.json into secrets/ and it is found
# automatically — nothing to set here. Override the location only if needed:
# YOUTUBE_CLIENT_SECRETS=/path/to/client_secret.json
#
# An AIza… API key cannot upload; uploads need the OAuth client above.
#
# TikTok: developers.tiktok.com → your app → add the "Content Posting API"
# product with the video.upload scope. The redirect URI must match exactly.
# Public site (Privacy / Terms / OAuth callback) lives in docs/ → GitHub Pages (main → /docs).
# After Pages is live, set the redirect to that callback URL, e.g.:
#   https://ambrosekuo.github.io/league-content-creation-assistant/callback/
# App website / Privacy / Terms fields should point at the same Pages host.
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# TIKTOK_REDIRECT_URI=https://ambrosekuo.github.io/league-content-creation-assistant/callback/

# --- GCS archive (Cloud Run / upload-dataset) ---
# Project: poststream-assistant
# GCS_BUCKET=poststream-assistant-archive
# GCS_PREFIX=vods
# Stings / brand stills / lofi beds (gitignored wav+mp3). Same bucket, STANDARD class:
# GCS_ASSETS_PREFIX=assets
# Optional dedicated bucket (otherwise uses GCS_BUCKET):
# GCS_ASSETS_BUCKET=poststream-assistant-archive
# WORK_DIR=/tmp/vod-work
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
